import csv
import os

import ifcopenshell
import ifcopenshell.util.element as element

# --- 1. Load the original IFC model ---
model_path = r"C:/Users/Amalie Pallesen/OneDrive - OsloMet/Dokumenter/Msc Sustainable Energy Systems/Semester 3/Advanced BIM/AssignmentAddingCode.ifc"
model = ifcopenshell.open(model_path)

# --- 2. Set the output folder and file ---
output_folder = r"C:/Users/Amalie Pallesen/OneDrive - OsloMet/Dokumenter/Msc Sustainable Energy Systems/Semester 3/Advanced BIM/output"
os.makedirs(output_folder, exist_ok=True)
output_file = os.path.join(output_folder, "IndoorClimate.csv")

PSET_NAME = "Custom_RoomClimateData"

TEMP_NAMES = {
    "temperature",
    "indoor_temperature",
    "design_temperature",
    "target_temperature",
    "room_temperature",
    "setpoint_temperature",
}

# --- 3. Create the CSV file ---
with open(output_file, "w", newline="", encoding="utf-8-sig") as file:
    writer = csv.writer(file)
    writer.writerow([
        "Room Name",
        "Room Number",
        "Temperature (°C)",
        "Occupancy",
        "Supply Airflow (L/s)",
    ])

    # --- 4. Loop through all IfcSpaces ---
    for space in model.by_type("IfcSpace"):
        room_name = space.LongName or ""
        room_number = space.Name or ""
        temperature_value = None

        # --- 5. Search the room's property sets for temperature ---
        for definition in space.IsDefinedBy:
            if not definition.is_a("IfcRelDefinesByProperties"):
                continue

            pset = definition.RelatingPropertyDefinition
            for prop in getattr(pset, "HasProperties", ()) or ():
                if prop.Name.lower() in TEMP_NAMES:
                    nominal_value = getattr(prop, "NominalValue", None)
                    if nominal_value is not None:
                        temperature_value = nominal_value.wrappedValue

        # --- 6. Read occupancy and supply airflow, as in Code 3 ---
        climate_data = element.get_pset(space, PSET_NAME) or {}
        occupancy = climate_data.get("DesignOccupancy")
        supply_airflow = climate_data.get("DesignSupplyAirflow_Ls")

        # --- 7. Write one row per room ---
        writer.writerow([
            room_name,
            room_number,
            temperature_value,
            occupancy,
            supply_airflow,
        ])

print(f"Indoor climate CSV created: {output_file}")
