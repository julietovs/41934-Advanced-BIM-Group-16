<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_Climate" targetNamespace="https://group16.example/indoor-climate" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.31.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool" name="Indoor Climate Check | Group 16" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Tool" name="Python Tool / IfcOpenShell">
        <bpmn:flowNodeRef>Extract</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Match</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Export</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RoomCheck</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Designer" name="Ventilation Designer">
        <bpmn:flowNodeRef>Provide</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Analyst" name="Analyst">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewData</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Comfort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Refer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndComfort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Limit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Communicate</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Select" name="Select claim and define criteria">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="ReviewData" name="Inspect IFC and review thermal comfort data">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
      <bpmn:ioSpecification id="ReviewData_IO">
        <bpmn:dataInput id="d1_port" />
        <bpmn:inputSet id="ReviewData_Inputs">
          <bpmn:dataInputRefs>d1_port</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="ReviewData_Outputs" />
      </bpmn:ioSpecification>
      <bpmn:property id="Property_1om2pds" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="d1">
        <bpmn:sourceRef>IFC</bpmn:sourceRef>
        <bpmn:targetRef>Property_1om2pds</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Comfort" name="Sufficient thermal comfort data?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Refer" name="Refer for separate thermal comfort verification">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndComfort">
      <bpmn:incoming>f5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Limit" name="Record limitation and select ventilation check">
      <bpmn:incoming>f6</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Extract" name="Extract offices and meeting rooms: IfcSpace">
      <bpmn:incoming>f7</bpmn:incoming>
      <bpmn:outgoing>f8</bpmn:outgoing>
      <bpmn:ioSpecification id="Extract_IO">
        <bpmn:dataInput id="d2_port" />
        <bpmn:inputSet id="Extract_Inputs">
          <bpmn:dataInputRefs>d2_port</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Extract_Outputs" />
      </bpmn:ioSpecification>
      <bpmn:property id="Property_07r9ocu" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="d2">
        <bpmn:sourceRef>IFC</bpmn:sourceRef>
        <bpmn:targetRef>Property_07r9ocu</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="Provide" name="Provide available design occupancy and supply airflow">
      <bpmn:incoming>f8</bpmn:incoming>
      <bpmn:outgoing>f9</bpmn:outgoing>
      <bpmn:ioSpecification id="Provide_IO">
        <bpmn:dataOutput id="d4_port" />
        <bpmn:inputSet id="Provide_Inputs" />
        <bpmn:outputSet id="Provide_Outputs">
          <bpmn:dataOutputRefs>d4_port</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="d4">
        <bpmn:sourceRef>d4_port</bpmn:sourceRef>
        <bpmn:targetRef>RoomData</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:serviceTask id="Match" name="Read and match room data">
      <bpmn:incoming>f9</bpmn:incoming>
      <bpmn:outgoing>f10</bpmn:outgoing>
      <bpmn:ioSpecification id="Match_IO">
        <bpmn:dataInput id="d5_port" />
        <bpmn:inputSet id="Match_Inputs">
          <bpmn:dataInputRefs>d5_port</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Match_Outputs" />
      </bpmn:ioSpecification>
      <bpmn:property id="Property_02anwvr" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="d5">
        <bpmn:sourceRef>RoomData</bpmn:sourceRef>
        <bpmn:targetRef>Property_02anwvr</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Export" name="Export results for all rooms">
      <bpmn:incoming>f11</bpmn:incoming>
      <bpmn:outgoing>f12</bpmn:outgoing>
      <bpmn:ioSpecification id="Export_IO">
        <bpmn:dataOutput id="d6_port" />
        <bpmn:inputSet id="Export_Inputs" />
        <bpmn:outputSet id="Export_Outputs">
          <bpmn:dataOutputRefs>d6_port</bpmn:dataOutputRefs>
        </bpmn:outputSet>
      </bpmn:ioSpecification>
      <bpmn:dataOutputAssociation id="d6">
        <bpmn:sourceRef>d6_port</bpmn:sourceRef>
        <bpmn:targetRef>Results</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:subProcess id="RoomCheck" name="Check each room (repeat for all selected rooms)">
      <bpmn:incoming>f10</bpmn:incoming>
      <bpmn:outgoing>f11</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics isSequential="true" />
      <bpmn:startEvent id="RoomStart">
        <bpmn:outgoing>r1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Complete" name="Sufficient valid data?">
        <bpmn:incoming>r1</bpmn:incoming>
        <bpmn:outgoing>r2</bpmn:outgoing>
        <bpmn:outgoing>r3</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Missing" name="Record insufficient data">
        <bpmn:incoming>r2</bpmn:incoming>
        <bpmn:outgoing>r7</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Calculate" name="Calculate required airflow: 7N + 0.7A [L/s]">
        <bpmn:incoming>r3</bpmn:incoming>
        <bpmn:outgoing>r4</bpmn:outgoing>
        <bpmn:ioSpecification id="Calculate_IO">
          <bpmn:dataInput id="d3_port" />
          <bpmn:inputSet id="Calculate_Inputs">
            <bpmn:dataInputRefs>d3_port</bpmn:dataInputRefs>
          </bpmn:inputSet>
          <bpmn:outputSet id="Calculate_Outputs" />
        </bpmn:ioSpecification>
        <bpmn:property id="Property_1htcby2" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="d3">
          <bpmn:sourceRef>Criteria</bpmn:sourceRef>
          <bpmn:targetRef>Property_1htcby2</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Meets" name="Design supply airflow meets requirement?">
        <bpmn:incoming>r4</bpmn:incoming>
        <bpmn:outgoing>r5</bpmn:outgoing>
        <bpmn:outgoing>r6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Pass" name="Record sufficient airflow">
        <bpmn:incoming>r5</bpmn:incoming>
        <bpmn:outgoing>r8</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Fail" name="Record insufficient airflow">
        <bpmn:incoming>r6</bpmn:incoming>
        <bpmn:outgoing>r9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Merge">
        <bpmn:incoming>r7</bpmn:incoming>
        <bpmn:incoming>r8</bpmn:incoming>
        <bpmn:incoming>r9</bpmn:incoming>
        <bpmn:outgoing>r10</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="RoomEnd">
        <bpmn:incoming>r10</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="r1" sourceRef="RoomStart" targetRef="Complete" />
      <bpmn:sequenceFlow id="r2" name="No" sourceRef="Complete" targetRef="Missing" />
      <bpmn:sequenceFlow id="r3" name="Yes" sourceRef="Complete" targetRef="Calculate" />
      <bpmn:sequenceFlow id="r4" sourceRef="Calculate" targetRef="Meets" />
      <bpmn:sequenceFlow id="r5" name="Yes" sourceRef="Meets" targetRef="Pass" />
      <bpmn:sequenceFlow id="r6" name="No" sourceRef="Meets" targetRef="Fail" />
      <bpmn:sequenceFlow id="r7" sourceRef="Missing" targetRef="Merge" />
      <bpmn:sequenceFlow id="r8" sourceRef="Pass" targetRef="Merge" />
      <bpmn:sequenceFlow id="r9" sourceRef="Fail" targetRef="Merge" />
      <bpmn:sequenceFlow id="r10" sourceRef="Merge" targetRef="RoomEnd" />
    </bpmn:subProcess>
    <bpmn:task id="Review" name="Review results and assess ventilation claim">
      <bpmn:incoming>f12</bpmn:incoming>
      <bpmn:outgoing>f13</bpmn:outgoing>
      <bpmn:ioSpecification id="Review_IO">
        <bpmn:dataInput id="d7_port" />
        <bpmn:inputSet id="Review_Inputs">
          <bpmn:dataInputRefs>d7_port</bpmn:dataInputRefs>
        </bpmn:inputSet>
        <bpmn:outputSet id="Review_Outputs" />
      </bpmn:ioSpecification>
      <bpmn:property id="Property_0er3ohp" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="d7">
        <bpmn:sourceRef>Results</bpmn:sourceRef>
        <bpmn:targetRef>Property_0er3ohp</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:task id="Communicate" name="Communicate findings">
      <bpmn:incoming>f13</bpmn:incoming>
      <bpmn:outgoing>f14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Receive" name="Review findings and resolve data or design issues">
      <bpmn:incoming>f14</bpmn:incoming>
      <bpmn:outgoing>f15</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="end">
      <bpmn:incoming>f15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="IFC" name="IFC model: IfcSpace; properties and quantities" dataObjectRef="IFC_Object" />
    <bpmn:dataObject id="IFC_Object" />
    <bpmn:dataObjectReference id="Criteria" name="Report: Category II criteria" dataObjectRef="Criteria_Object" />
    <bpmn:dataObject id="Criteria_Object" />
    <bpmn:dataObjectReference id="RoomData" name="Supplementary room data: IDs, occupancy, supply airflow" dataObjectRef="RoomData_Object" />
    <bpmn:dataObject id="RoomData_Object" />
    <bpmn:dataObjectReference id="Results" name="Room-level results" dataObjectRef="Results_Object" />
    <bpmn:dataObject id="Results_Object" />
    <bpmn:sequenceFlow id="f1" sourceRef="Start" targetRef="Select" />
    <bpmn:sequenceFlow id="f2" sourceRef="Select" targetRef="ReviewData" />
    <bpmn:sequenceFlow id="f3" sourceRef="ReviewData" targetRef="Comfort" />
    <bpmn:sequenceFlow id="f4" name="Yes" sourceRef="Comfort" targetRef="Refer" />
    <bpmn:sequenceFlow id="f6" name="No" sourceRef="Comfort" targetRef="Limit" />
    <bpmn:sequenceFlow id="f5" sourceRef="Refer" targetRef="EndComfort" />
    <bpmn:sequenceFlow id="f7" sourceRef="Limit" targetRef="Extract" />
    <bpmn:sequenceFlow id="f8" sourceRef="Extract" targetRef="Provide" />
    <bpmn:sequenceFlow id="f9" sourceRef="Provide" targetRef="Match" />
    <bpmn:sequenceFlow id="f10" sourceRef="Match" targetRef="RoomCheck" />
    <bpmn:sequenceFlow id="f11" sourceRef="RoomCheck" targetRef="Export" />
    <bpmn:sequenceFlow id="f12" sourceRef="Export" targetRef="Review" />
    <bpmn:sequenceFlow id="f13" sourceRef="Review" targetRef="Communicate" />
    <bpmn:sequenceFlow id="f14" sourceRef="Communicate" targetRef="Receive" />
    <bpmn:sequenceFlow id="f15" sourceRef="Receive" targetRef="End" />
  </bpmn:process>
